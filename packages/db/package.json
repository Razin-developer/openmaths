    "typecheck": "tsc --noEmit",
    "seed:test": "tsx --env-file=.env scripts/seed-test.ts"
  },
  "dependencies": {
    "@openmaths/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
