{
  "name": "@openmaths/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./generated/prisma/client.ts",
    "./enums": "./generated/prisma/enums.ts",
    "./canvasAccess": "./src/canvasAccess.ts",
    "./notifications": "./src/notifications.ts",
    "./budget": "./src/budget.ts",
    "./usageStats": "./src/usageStats.ts",
    "./funnelStats": "./src/funnelStats.ts",
    "./board/context": "./src/board/context.ts",
    "./board/graphSync": "./src/board/graphSync.ts",
    "./board/webLinkSync": "./src/board/webLinkSync.ts",
    "./board/linkCheck": "./src/board/linkCheck.ts",
    "./auth/rateLimit": "./src/auth/rateLimit.ts",
    "./auth/passwordPolicy": "./src/auth/passwordPolicy.ts",
    "./auth/totp": "./src/auth/totp.ts",
    "./auth/sessions": "./src/auth/sessions.ts",
    "./auth/verification": "./src/auth/verification.ts",
    "./auth/passwordReset": "./src/auth/passwordReset.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "migrate:dev": "prisma migrate dev",
