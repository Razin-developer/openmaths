# Secrets for `docker compose up` (docker-compose.yml) — copy to `.env` and fill in. Postgres
# itself, ports, and inter-container URLs are already wired in docker-compose.yml; this file only
# holds the values compose can't safely default.

# openssl rand -base64 32 — must be the SAME value app and server both read, since server issues
# the session cookie and app's auth.ts independently re-verifies it against this same secret.
AUTH_SECRET=

# https://ai.hackclub.com/dashboard — teens 18 and under only.
HACKCLUB_AI_API_KEY=

# Comma-separated allowlist of origins allowed to call `server` — the app container's
# externally-reachable origin (not its in-network service name).
CORS_ORIGIN=http://localhost:3000

# `server`'s externally-reachable origin, as the end user's own browser will call it — baked into
# app's client bundle at build time, so this must be set BEFORE `docker compose build`, not just
# before `up`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# The parent registrable domain the session cookie is scoped to (e.g. ".openmaths.com") once app
# and server are deployed on separate subdomains of the same domain. Leave empty for local
# docker-compose — a host-only cookie is correct there.
COOKIE_DOMAIN=
