# The product app's URL — "Open app" CTAs link here. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The Hono API server's URL — contact/feedback/report-bug forms POST here directly from the
# browser. server's own CORS_ORIGIN must include this site's origin (see server/.env.example).
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# PostHog (PRD §8 "privacy-friendly analytics"). Analytics is fully off when this is unset — no
# placeholder/fake key needed to make the build succeed. This is a project API key, not a secret
# (PostHog's own key, designed to ship in client-side JS) — safe to commit here once you have one.
NEXT_PUBLIC_POSTHOG_KEY=
# Only needed if your PostHog project is in the EU region — https://eu.i.posthog.com. Defaults to
# the US region (https://us.i.posthog.com) when unset.
NEXT_PUBLIC_POSTHOG_HOST=
